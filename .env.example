# Local Postgres only. This project holds synthetic data and must never be
# pointed at a cloud database, in tests or otherwise.
DATABASE_URL="postgresql://USER@localhost:5432/clearpath_dev?connection_limit=10&pool_timeout=20"
SHADOW_DATABASE_URL="postgresql://USER@localhost:5432/clearpath_shadow"

# Keys the hash of a public-enquiry submitter's address, so the throttle table
# holds no recoverable list of who enquired. Names only — never a real value in
# a tracked file.
#
# Optional. With it unset the key falls back to a per-process random, which
# fails safe rather than weak: the hashes stay unrecoverable, but the hourly
# limit no longer spans instances or survives a restart. Set it in any
# deployment running more than one instance.
CLEARPATH_THROTTLE_SECRET=""

# Vercel Cron sends this as a bearer on /api/cron/reminders and /api/cron/purge.
# Unset, both routes refuse every call — the schedule then runs nothing, so set
# it in the deployment's environment. Names only.
CRON_SECRET=""
