# Local Postgres only. This project holds synthetic data and must never be
# pointed at a cloud database, in tests or otherwise.
DATABASE_URL="postgresql://USER@localhost:5432/clearpath_dev?connection_limit=10&pool_timeout=20"
SHADOW_DATABASE_URL="postgresql://USER@localhost:5432/clearpath_shadow"

# The shared secret an SMS provider presents when POSTing an inbound reply to
# /api/inbound. Unset means the route refuses every request, which is the safe
# default for the one write endpoint with no session behind it.
INBOUND_WEBHOOK_SECRET="change-me-locally"

# The carrier posts delivery receipts here. Its own key, not the inbound one:
# a receipt credential must not also be able to decline somebody's appointment.
DELIVERY_WEBHOOK_SECRET="local-dev-delivery-secret"
