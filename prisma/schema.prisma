// Clearpath — Stillwater Counseling operations.
// Synthetic data only. See the Scope Honesty banner in README.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── people ───────────────────────────────

enum Role {
  front_desk
  therapist
  associate
  supervisor
  admin
  auditor
  /// Never logs in. Exists so a form submitted through a tokenized link has an
  /// honest actor in the audit trail instead of being attributed to staff.
  client
}

model User {
  id     String  @id @default(cuid())
  name   String
  email  String  @unique
  role   Role
  active Boolean @default(true)

  /// Supervision is data, not code: repointing this reroutes both read access
  /// to progress notes and the co-signature queue, with no deploy.
  supervisorId String?
  supervisor   User?   @relation("supervision", fields: [supervisorId], references: [id])
  supervisees  User[]  @relation("supervision")

  clients       Client[]
  appointments  Appointment[]
  series        AppointmentSeries[]
  availability  Availability[]
  overrides     AvailabilityOverride[]
  progressNotes ProgressNote[]         @relation("noteAuthor")
  coSigned      ProgressNote[]         @relation("noteCoSigner")
  processNotes  ProcessNote[]
  amendments    NoteAmendment[]
  alerts        Alert[]

  /// scrypt, encoded with its own parameters. See `src/auth/password.ts`.
  ///
  /// Nullable because an account can exist before anybody has set a password
  /// on it — a new hire whose row the practice manager created this morning.
  /// That account cannot sign in, and the login route says the same sentence
  /// it says for a wrong password: an account with no credential is exactly
  /// the one an attacker most wants to find.
  passwordHash String?

  /// Base32 TOTP secret, and when the person finished enrolling.
  ///
  /// Null means not enrolled. For a role `requiresSecondFactor` covers, that
  /// is not a way past the check — it is a mandatory enrolment before the
  /// session becomes usable, which is the only ordering that does not leave a
  /// clinical account reachable with one factor.
  totpSecret     String?
  totpEnrolledAt DateTime?

  /// The last TOTP step this account spent, so it can never be spent again.
  ///
  /// A code is valid for its whole 30-second window, so one shoulder-surfed or
  /// phished code works again until it expires. Recording the step is what
  /// makes every accepted code single-use. On the account rather than on the
  /// session, because a stolen code must not work in a *different* session.
  totpLastStep BigInt?

  /// Failed sign-in throttling. Escalating and self-expiring, never permanent —
  /// see `src/auth/lockout.ts` for why a hard lock would be a weapon.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  authSessions   AuthSession[]
  passwordResets PasswordReset[]
  invitations    Invitation[]

  createdAt                 DateTime            @default(now())
  rescheduleRequestsHandled RescheduleRequest[]
}

/// A signed-in staff session, held server-side.
///
/// The cookie carries an opaque random token and nothing else. What is stored
/// here is its SHA-256, so the session table is not itself a set of working
/// credentials: a dump of this table lets nobody sign in as anybody. That is
/// the same reasoning as `passwordHash`, applied to the thing the password
/// buys you, and it is the difference between a login and the previous
/// `clearpath_user` cookie, which was a user id anybody could type.
model AuthSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the bearer token. The token itself exists only in the cookie.
  tokenHash String @unique

  createdAt DateTime
  /// Advanced on use, and what the idle timeout is measured from.
  lastSeenAt DateTime
  /// The absolute ceiling. A session does not outlive this however active.
  expiresAt DateTime

  /// When the second factor was satisfied.
  ///
  /// Null is the half-authenticated state: the password was right and nothing
  /// else has happened yet. A session in that state reaches the challenge
  /// screen and no other page, which is why this is a column rather than a
  /// separate "pending" table — there is one session object through the whole
  /// sign-in, and its authority grows by one field.
  secondFactorAt DateTime?

  /// A secret generated for enrolment and not yet proved by a code.
  ///
  /// Held on the session rather than round-tripped through a hidden form
  /// field, because a secret the browser hands back is a secret an attacker
  /// can substitute — enrol their own authenticator against somebody else's
  /// account and the second factor is theirs. It is promoted onto the `User`
  /// only when a code generated from it verifies, so an enrolment abandoned
  /// halfway leaves an account with no secret rather than one nobody holds.
  pendingTotpSecret String?

  revokedAt DateTime?
  /// Why it ended: `signed_out`, `deactivated`, `superseded`, `password_changed`.
  /// A reason code, never a sentence about a person.
  revokedReason String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// A password reset in flight.
///
/// Deliberately not a variant of `AuthSession`. A session is a thing that
/// authorizes and grows authority by one field; this is a thing that authorizes
/// nothing and never will — completing it signs nobody in, it sets a password
/// and ends every session the account had. Folding the two together would put
/// a row in the session table whose whole job is to not be a session.
///
/// Same storage discipline as `AuthSession`: the token exists in the link and
/// nowhere else, and what is written here is its SHA-256, so a dump of this
/// table lets nobody reset anybody.
model PasswordReset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the link's token.
  tokenHash String @unique

  createdAt DateTime
  /// Short, because the thing this addresses is a link sitting in a mailbox.
  expiresAt DateTime

  /// When the second factor was proved *for this reset*.
  ///
  /// Null is the half-proved state, and it is the same shape as
  /// `AuthSession.secondFactorAt` for the same reason: there is one object
  /// through the whole flow, and its authority grows by one field. It is per
  /// reset rather than per user because proving a factor once must not license
  /// every future link.
  secondFactorAt DateTime?

  /// Spent. A link works once, whatever else is true of it.
  usedAt DateTime?

  revokedAt DateTime?
  /// `superseded`, `second_factor_cleared`. A reason code, never a sentence.
  revokedReason String?

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// An account that exists and has never been claimed.
///
/// A separate table from `PasswordReset` rather than a `kind` column on it, and
/// the reason is that they are different decisions with different rules — see
/// the header of `src/auth/accounts.ts`. A reset asks whether a mailbox still
/// belongs to somebody who already holds this account; an invitation hands over
/// an account nobody holds yet. Sharing a table would have meant one row shape
/// carrying two sets of conditions and a branch on every read.
model Invitation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the link's token. The link goes to the person's mailbox.
  tokenHash String @unique

  /// SHA-256 of the short code, normalized. The code goes by some other route
  /// entirely — read out by the practice manager — and is what stops a link in
  /// a mailbox from being the whole of a new clinical account's way in.
  ///
  /// Stored as a digest for the same reason a password is: a dump of this table
  /// must not be a set of working credentials.
  codeHash String

  /// Wrong codes so far. At `MAX_CODE_ATTEMPTS` the invitation is revoked
  /// rather than throttled — re-issuing is one click for the practice manager
  /// and a dead end for anybody else.
  attempts Int @default(0)

  createdAt DateTime
  /// Long, unlike a reset link: half its life is somebody waiting on a phone
  /// call about the code, and this is sent to a person who does not work here
  /// yet.
  expiresAt DateTime

  /// Claimed. The account has a password from this moment, and
  /// `credentialRoute` never returns `invite` for it again.
  acceptedAt DateTime?

  revokedAt DateTime?
  /// `superseded`, `code_attempts`, `deactivated`. A reason code, never a sentence.
  revokedReason String?

  @@index([userId, acceptedAt])
  @@index([expiresAt])
}

enum ReminderPreference {
  email
  sms
  none
}

/// The language a client reads.
///
/// Deliberately a short enum rather than a locale string: every value here has
/// to be backed by a full set of message bodies *and* its own deny-list, and a
/// free-text locale invites `pt-BR` to be set on a client nobody can write to.
/// Adding one is a checklist, and a test enforces the checklist.
enum Language {
  en
  es
}

/// P2-3. The cadence a client asked for, as opposed to the one they earned.
///
/// There is deliberately no value meaning "no messages". That is
/// `ReminderPreference.none`, which is a safety setting and carries an
/// exemption from the non-response fee — a volume control must not become a
/// second route to it.
enum ReminderCadence {
  /// Five days out, the day before, and the day of. The default, and the only
  /// value nobody chose.
  full
  /// The day-before message alone — the same one the streak cap produces.
  day_before
  /// The day-of nudge alone.
  day_of
}

enum ClientStatus {
  active
  inactive
}

model Client {
  id   String @id @default(cuid())
  /// Obviously-fake display code for seeded data, e.g. "TC-001".
  code String @unique

  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  email       String?
  phone       String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  treatingClinicianId String
  treatingClinician   User   @relation(fields: [treatingClinicianId], references: [id])

  /// Sliding-scale override in integer cents. Null falls back to the practice
  /// standard fee.
  feeCents Int?

  reminderPreference ReminderPreference @default(email)
  /// What the practice may write to them in. A template with no body in this
  /// language is not sent at all — see `queueToClient` — which means the client
  /// is never asked and so can never be charged for not answering.
  language           Language           @default(en)
  /// P2-3. How many of the three confirmation stages this client wants. A
  /// stated preference; the streak cap narrows `full` and nothing else.
  reminderCadence    ReminderCadence    @default(full)
  status             ClientStatus       @default(active)

  appointments  Appointment[]
  series        AppointmentSeries[]
  progressNotes ProgressNote[]
  processNotes  ProcessNote[]
  formRequests  FormRequest[]
  submissions   FormSubmission[]
  alerts        Alert[]
  outbox        OutboxMessage[]
  waitlist      WaitlistEntry[]

  createdAt          DateTime            @default(now())
  portalLinks        PortalLink[]
  rescheduleRequests RescheduleRequest[]
  inboundReplies     InboundReply[]

  @@index([treatingClinicianId])
}

model PracticeSettings {
  id                    Int    @id @default(1)
  name                  String @default("Stillwater Counseling")
  /// The name that appears in messages to clients. Deliberately not the legal
  /// name: "Stillwater Counseling" in an SMS preview on a lock screen tells a
  /// roommate what the appointment is for.
  messagingName         String @default("Stillwater")
  standardFeeCents      Int    @default(18000)
  lateCancelWindowHours Int    @default(24)
  lateCancelFeeCents    Int    @default(9000)
  /// How far ahead recurring series materialise instances.
  recurrenceHorizonDays Int    @default(90)
  /// P1-1: a client is "continuity at risk" after this long with nothing booked.
  continuityGapDays     Int    @default(21)

  /// A no-show is its own policy. Ships at the late-cancel figure so the field
  /// changes no behaviour on the day it lands; the practice raises it without a
  /// code change. Integer cents.
  noShowFeeCents        Int    @default(9000)
  /// Lead time for the day-of confirmation stage.
  dayOfLeadHours        Int    @default(3)
  /// Below this much notice there was no time to ask, and after this much of
  /// the session has passed, silence is an answer.
  graceMinutes          Int    @default(20)
  /// Gates only the automatic `no_show` transition and its fee. With it off,
  /// non-response is still recorded — the evidence is never optional.
  autoNoShowOnNoResponse Boolean @default(true)
  /// P1-2. Consecutive confirmations after which a client drops to the
  /// day-before reminder alone, until they miss one. 0 turns the cap off and
  /// every client gets all three stages, forever, which is the volume problem
  /// this field exists to bound.
  confirmationStreakCap  Int     @default(4)
  /// P2-3. How long before the start a message must have *arrived* for silence
  /// after it to count as an answer. `graceMinutes` says there was time to ask;
  /// this says there was time to answer, and until per-client cadences existed
  /// nothing needed to ask it — a five-day-out message always had time.
  ///
  /// Two hours is a judgement, not a derivation: shorter than a working
  /// morning, longer than a meeting. 0 turns the check off, which puts the fee
  /// back on messages that arrived with minutes to spare.
  answerWindowMinutes    Int     @default(120)
  /// The number front desk answers. It reaches exactly one client-facing body:
  /// the auto-reply to a message this system cannot read, which has to end
  /// somewhere a person picks up.
  contactPhone           String  @default("555-0100")
}

model Room {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  appointments Appointment[]
  series       AppointmentSeries[]
}

// ───────────────────────────── availability ─────────────────────────────

model Availability {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  /// 0 = Sunday.
  weekday     Int
  /// Minutes from local midnight, practice timezone.
  startMinute Int
  endMinute   Int

  @@unique([userId, weekday, startMinute])
}

enum OverrideKind {
  unavailable
  available
}

model AvailabilityOverride {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  /// Inclusive date range, so a week of vacation is one row.
  fromDate    DateTime     @db.Date
  toDate      DateTime     @db.Date
  kind        OverrideKind @default(unavailable)
  startMinute Int?
  endMinute   Int?
  /// Operational, never clinical. Shown to front desk.
  reason      String?

  @@index([userId, fromDate])
}

// ────────────────────────────── scheduling ──────────────────────────────

enum AppointmentType {
  intake // 75 min
  standard // 50 min
  extended // 80 min
}

enum Modality {
  in_person
  telehealth
}

enum Frequency {
  weekly
  biweekly
}

model AppointmentSeries {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  clinicianId String
  clinician   User    @relation(fields: [clinicianId], references: [id])
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id])

  type     AppointmentType @default(standard)
  modality Modality        @default(in_person)

  frequency   Frequency @default(weekly)
  weekday     Int
  startMinute Int

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  active    Boolean   @default(true)

  appointments Appointment[]
  createdAt    DateTime      @default(now())

  @@index([clientId])
  @@index([clinicianId])
}

enum AppointmentStatus {
  scheduled
  confirmed
  arrived
  in_session
  completed
  no_show
  cancelled
  late_cancelled
}

/// A communication fact, and never an attendance fact. `status` says whether
/// the client was in the room; this says whether they answered the question.
/// Collapsing the two makes charging somebody who turned up reachable by
/// writing no code at all.
enum AppointmentConfirmation {
  not_required
  pending
  confirmed
  declined
  no_response
}

/// A fixed list, not free text: a waiver reason is a category the practice
/// reports on, and free text on a money reversal becomes a place to write
/// something clinical.
enum FeeWaiveReason {
  practice_error
  client_disputed
  emergency
  goodwill
}

model Appointment {
  id             String             @id @default(cuid())
  seriesId       String?
  series         AppointmentSeries? @relation(fields: [seriesId], references: [id])
  /// P2: a group session is N appointments sharing this key, one per attendee,
  /// so notes, fees, attendance and audit stay per-client. The exclusion
  /// constraints treat co-attendees as one booking of the clinician and room.
  groupSessionId String?
  groupSession   GroupSession?      @relation(fields: [groupSessionId], references: [id])
  /// A rescheduled instance detaches from its pattern and stops being
  /// regenerated. Same regression that bit Groundwork.
  detached       Boolean            @default(false)

  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  clinicianId String
  clinician   User    @relation(fields: [clinicianId], references: [id])
  /// Null for telehealth. The room requirement is conditional on modality —
  /// enforced by a CHECK constraint in the migration, not just here.
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id])

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// When *this hour* was set — at booking, and again at every reschedule.
  ///
  /// Distinct from `createdAt`, which is when the row was made and never moves.
  /// The confirmation rules need the other question: how much notice the client
  /// has had of the time they are actually expected at. `dueStages` will not
  /// queue a stage whose moment fell before this, and `confirmationRequired`
  /// measures notice from it — so a moved appointment is asked about from
  /// scratch, and the messages about the hour it used to be at stop counting as
  /// having asked.
  bookedAt DateTime @db.Timestamptz(3)

  type     AppointmentType   @default(standard)
  modality Modality          @default(in_person)
  status   AppointmentStatus @default(scheduled)

  /// Telehealth join URL. Not a video integration; a text field.
  joinLink String?

  cancelledAt    DateTime?
  cancelledById  String?
  /// Operational reason only ("client rescheduled"). Never clinical.
  cancelReason   String?
  /// Set when a cancellation lands inside the late-cancel window, or on
  /// no-show. Chargeable flag only — no payment processing here.
  chargeFeeCents Int?

  /// Written by the cadence job and the client's own door, by nothing else.
  confirmation   AppointmentConfirmation @default(not_required)

  /// A waiver zeroes the flag and records who decided. The original amount
  /// stays recoverable from the audit trail rather than being overwritten out
  /// of existence. Practice manager only.
  feeWaivedById  String?
  feeWaivedAt    DateTime?
  feeWaiveReason FeeWaiveReason?

  /// Idempotency key for recurrence materialisation: series + occurrence date.
  occurrenceKey String? @unique

  progressNote       ProgressNote?
  processNotes       ProcessNote[]
  rescheduleRequests RescheduleRequest[]
  reminders          AppointmentReminder[]
  inboundReplies     InboundReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicianId, startAt])
  @@index([clientId, startAt])
  @@index([roomId, startAt])
  @@index([status, startAt])
  @@index([groupSessionId])
  @@index([confirmation, startAt])
}

enum ReminderStage {
  d5
  d1
  d0
}

/// One row per appointment per stage, under a unique index — the same
/// idempotency-key discipline as `Appointment.occurrenceKey`. A second horizon
/// run over the same window sees the row and skips, so a cadence cannot double
/// -send by being run twice.
model AppointmentReminder {
  id              String        @id @default(cuid())
  appointmentId   String
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  stage           ReminderStage
  dueAt           DateTime      @db.Timestamptz(3)
  sentAt          DateTime?
  /// The proof the practice asked — and, since P2, the proof it arrived: the
  /// fee rule reads this message's `deliveryState`, so it is a relation rather
  /// than a loose id. A reminder pointing at a message that no longer exists
  /// was always an integrity gap; it is a money bug now.
  outboxMessageId String?
  outboxMessage   OutboxMessage? @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The idempotency key, and it names the hour on purpose.
  ///
  /// `dueAt` is derived from the appointment's `startAt` and a fixed lead, so
  /// two runs over an unmoved appointment compute the same key and the second
  /// loses the race — which is all this key was ever for. What it now also
  /// says is that a *moved* appointment is a different question: its stages
  /// fall at new moments, so the cadence may ask again without the old rows
  /// standing in the way, and the old rows stay where they are. The trail of
  /// what the practice sent about the hour it withdrew is evidence, not
  /// clutter, and deleting it to make room for the next ask would be deleting
  /// the only proof of the first one.
  @@unique([appointmentId, stage, dueAt])
  @@index([dueAt, sentAt])
}

/// The shared half of a group session, and deliberately only that.
///
/// Time, clinician and room are NOT stored here: every attendee's appointment
/// already carries them, and a second copy is a second thing to keep in sync.
/// What is here is what has no other home — the operational label.
model GroupSession {
  id    String  @id @default(cuid())
  /// Operational label ("Tuesday skills group"). Never clinical content: this
  /// reaches the front-desk calendar.
  topic String?

  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

// ──────────────────────────── clinical notes ────────────────────────────

enum ProgressNoteStatus {
  draft
  signed
  cosigned
}

/// The official clinical record. Author + supervisor-of-author + break-glass.
model ProgressNote {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])

  authorId String
  author   User   @relation("noteAuthor", fields: [authorId], references: [id])

  content String
  status  ProgressNoteStatus @default(draft)

  signedAt     DateTime?
  coSignedById String?
  coSignedBy   User?     @relation("noteCoSigner", fields: [coSignedById], references: [id])
  coSignedAt   DateTime?

  amendments NoteAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([authorId, status])
}

/// The therapist's private working notes. Author-only at every layer — query,
/// API, export, search, report. There is no supervisor path and no break-glass
/// path to this table's content.
model ProcessNote {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content  String
  /// Signed-off equivalent: process notes have no signature workflow, but they
  /// become immutable once the author closes them, and amend appends.
  closedAt DateTime?

  amendments NoteAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, clientId])
}

enum NoteKind {
  progress
  process
}

/// Signed notes are immutable; corrections append an amendment.
model NoteAmendment {
  id   String   @id @default(cuid())
  kind NoteKind

  progressNoteId String?
  progressNote   ProgressNote? @relation(fields: [progressNoteId], references: [id])
  processNoteId  String?
  processNote    ProcessNote?  @relation(fields: [processNoteId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
}

// ──────────────────────────────── forms ────────────────────────────────

enum FormKind {
  intake
  consent
  screener
}

model FormTemplate {
  id        String   @id @default(cuid())
  key       String
  name      String
  kind      FormKind
  version   Int      @default(1)
  published Boolean  @default(false)

  /// Field definitions, including conditional-display rules.
  schema  Json
  /// Answer→value maps, total thresholds, and critical items. Versions with the
  /// template, so a v1 submission always scores by v1 rules.
  scoring Json?

  requests    FormRequest[]
  submissions FormSubmission[]

  createdAt DateTime @default(now())

  @@unique([key, version])
}

enum FormRequestStatus {
  sent
  started
  submitted
  expired
}

model FormRequest {
  id         String       @id @default(cuid())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id])
  /// Pinned to the exact template version the client is answering.
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id])

  /// Opaque, high-entropy, single-purpose. Carries no PHI.
  token     String            @unique
  status    FormRequestStatus @default(sent)
  expiresAt DateTime

  /// Answers saved as the client works. Tokenized links are resumable: a
  /// screener asking hard questions is not something to finish in one sitting.
  draftAnswers Json?

  sentAt      DateTime  @default(now())
  startedAt   DateTime?
  submittedAt DateTime?

  submission FormSubmission?

  @@index([clientId, status])
}

model FormSubmission {
  id         String       @id @default(cuid())
  requestId  String       @unique
  request    FormRequest  @relation(fields: [requestId], references: [id])
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id])
  /// The version answered. Rendering always uses this, never the latest.
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id])

  answers Json

  totalScore    Int?
  /// True when the total crossed a threshold or a critical item was flagged.
  needsReview   Boolean  @default(false)
  /// Rule identifiers only, e.g. ["threshold:moderate", "critical:item_9"].
  /// Never answer content — this string reaches alert and review surfaces.
  reviewReasons String[] @default([])

  /// Consent signature stub.
  signatureName String?
  signedAt      DateTime?

  alerts    Alert[]
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─────────────────────────── alerts and outbox ───────────────────────────

enum AlertKind {
  screener_threshold
  screener_critical_item
  /// P1-3. A client replied in words this system could not classify. Carries
  /// reason codes and nothing else — the words themselves were never stored.
  inbound_unparsed
}

/// What a client's reply was, and the only thing kept of it.
enum InboundClassification {
  confirm
  decline
  /// Anything else. The body is classified and discarded, never stored: a
  /// client can reply with anything, including the most acute thing they have
  /// ever written, and storing it would put clinical content on an operational
  /// surface and route it to the desk that must never see it.
  unparsed
  /// A carrier opt-out keyword. Not a decline — the client is unsubscribing,
  /// not cancelling — and it is answered with silence and a preference change.
  opt_out
}

/// A client texted back.
///
/// There is deliberately no `body` column, and that absence is the feature: it
/// is not possible to store what they wrote, so no future query can leak it.
/// A grep test in `inbound.test.ts` refuses any write that tries.
model InboundReply {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
  /// The session the reply was about, where there was an open question.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  classification InboundClassification
  channel        OutboxChannel

  receivedAt  DateTime  @default(now())
  /// Front desk rang them. Only `unparsed` replies need this — the rest were
  /// understood and acted on.
  handledAt   DateTime?
  handledById String?

  @@index([handledAt, receivedAt])
  @@index([clientId, receivedAt])
}

/// Routes to the treating clinician only. Never a shared surface, never front
/// desk. Carries reason codes, never answers or scores.
model Alert {
  id          String @id @default(cuid())
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id])
  clientId    String
  client      Client @relation(fields: [clientId], references: [id])

  submissionId String?
  submission   FormSubmission? @relation(fields: [submissionId], references: [id])

  kind    AlertKind
  reasons String[]  @default([])

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([recipientId, acknowledgedAt])
}

enum OutboxChannel {
  email
  sms
}

/// Nothing is actually sent. Bodies are lint-tested against a deny-list of
/// clinical terms — a reminder says "Appointment reminder", never why.
model OutboxMessage {
  id       String  @id @default(cuid())
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  /// Set for clinician-directed alerts.
  userId   String?

  channel     OutboxChannel
  templateKey String
  subject     String?
  body        String

  scheduledFor DateTime
  /// When a carrier accepted it. Null until something did — which, before the
  /// carrier port existed, was every row in this table.
  sentAt       DateTime?

  /// Where the message is from the practice's side of the wire. `sent` means a
  /// carrier took it; only `delivered` means anybody received it, and only
  /// `delivered` is allowed anywhere near the non-response fee.
  deliveryState DeliveryState    @default(queued)
  /// Attempts spent, not retries remaining.
  attempts      Int              @default(0)
  /// The provider's handle for the current attempt; its receipts quote it back.
  providerRef   String?          @unique
  /// Which driver holds it. `simulated` is the only one this repository ships.
  carrier       String?
  /// A closed code, never the provider's prose — that routinely echoes the body
  /// and the destination back, which would put both in an operational table.
  failureCode   DeliveryFailure?
  deliveredAt   DateTime?
  /// The carrier timestamp of the receipt that put it in its current state.
  /// Receipts are ordered by this, never by when they happened to arrive.
  decidedAt     DateTime?
  nextAttemptAt DateTime?
  /// The moment this message stops being worth sending — the start of the hour
  /// it is about. A reminder delivered after its own appointment teaches the
  /// client that this practice's messages are not worth reading.
  expiresAt     DateTime?

  receipts  DeliveryReceipt[]
  reminders AppointmentReminder[]

  createdAt DateTime @default(now())

  @@index([scheduledFor, sentAt])
  @@index([deliveryState, nextAttemptAt])
}

enum DeliveryState {
  queued
  sent
  delivered
  failed
}

enum DeliveryFailure {
  invalid_destination
  unreachable
  rejected
  opted_out_at_carrier
  carrier_unavailable
  expired
}

/// A carrier's word on one message: a state, a code, and two timestamps.
///
/// Kept as rows rather than collapsed into the message because the sequence is
/// the evidence. When a practice defends a fee, "we have proof it arrived" has
/// to be inspectable as *what the carrier said and when*, not as a boolean
/// somebody's job wrote. Receipts the state machine ignored are kept too —
/// a trail that only records the receipts that won is not a trail.
///
/// There is deliberately no body column and no destination column. Both would
/// be PHI-adjacent on an operational surface, and neither is needed to know
/// whether a message arrived.
model DeliveryReceipt {
  id              String        @id @default(cuid())
  outboxMessageId String
  outboxMessage   OutboxMessage @relation(fields: [outboxMessageId], references: [id], onDelete: Cascade)

  /// The attempt this receipt is about, so a late one can still be matched.
  providerRef String
  state       DeliveryState
  failureCode DeliveryFailure?
  attempt     Int

  /// The carrier's clock, which is the one that orders receipts.
  occurredAt DateTime
  /// Ours, which only says when we heard.
  receivedAt DateTime @default(now())
  /// Stale, or the losing half of a tie. It still happened, so it is still here.
  ignored    Boolean  @default(false)

  @@index([outboxMessageId, occurredAt])
  @@index([providerRef])
}

// ──────────────────────────────── waitlist ────────────────────────────────

model WaitlistEntry {
  id             String  @id @default(cuid())
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id])
  /// Preferred weekdays (0 = Sunday) and window, both optional.
  weekdays       Int[]   @default([])
  earliestMinute Int?
  latestMinute   Int?
  note           String?
  active         Boolean @default(true)

  createdAt DateTime @default(now())
}

// ───────────────────────────── audit trail ─────────────────────────────

/// Append-only. A database rule blocks UPDATE and DELETE — see the migration.
/// Ids only: no names, no note content, no answers, no scores.
model AuditEvent {
  id String   @id @default(cuid())
  at DateTime @default(now())

  actorId   String
  actorRole Role

  action     String
  resource   String
  resourceId String?
  /// Denormalised so "who touched client X" is one indexed query.
  clientId   String?

  allowed    Boolean
  /// Which permission rule decided it.
  rule       String
  breakGlass Boolean @default(false)
  /// Break-glass justification. Operational text typed by an admin.
  reason     String?

  @@index([clientId, at])
  @@index([actorId, at])
  @@index([breakGlass, at])
  @@index([at])
}

// ──────────────────────────── the client portal ────────────────────────────

/// A client's own door. Opaque, expiring, and carrying no PHI — the same shape
/// as a form link, for the same reason: a link that leaks discloses that this
/// person has appointments somewhere, and stops there.
model PortalLink {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  token     String   @unique
  expiresAt DateTime

  createdAt    DateTime  @default(now())
  lastOpenedAt DateTime?

  @@index([clientId])
}

/// Why a client wants a different time, as a code rather than a message.
///
/// A free-text box here would be a channel by which a client can write clinical
/// content to the one desk that must never see it. Front desk phones them back;
/// that conversation is not this system's to hold.
enum RescheduleReason {
  cannot_make_it
  need_a_different_time
  prefer_earlier
  prefer_later
}

enum RescheduleRequestStatus {
  open
  handled
  declined
}

/// A request, never a booking. The client asks; front desk decides and rebooks
/// by hand — the same rule as the waitlist, and for the same reason.
model RescheduleRequest {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])

  reason RescheduleReason
  status RescheduleRequestStatus @default(open)

  createdAt   DateTime  @default(now())
  handledById String?
  handledBy   User?     @relation(fields: [handledById], references: [id])
  handledAt   DateTime?

  @@index([status, createdAt])
  @@index([clientId])
}
