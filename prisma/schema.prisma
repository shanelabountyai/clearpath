// Clearpath — Stillwater Counseling operations.
// Synthetic data only. See the Scope Honesty banner in README.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── people ───────────────────────────────

enum Role {
  front_desk
  therapist
  associate
  supervisor
  admin
  auditor
  /// Never logs in. Exists so a form submitted through a tokenized link has an
  /// honest actor in the audit trail instead of being attributed to staff.
  client
  /// Nobody, on the public enquiry form. Here for the same reason `client` is:
  /// an enquiry that arrived through the website has to be attributable to what
  /// actually made it, and the alternative is borrowing a staff account for an
  /// act no member of staff performed. No `User` row ever holds it — see the
  /// `public` row of the permission matrix, which is one cell wide.
  public
}

model User {
  id     String  @id @default(cuid())
  name   String
  email  String  @unique
  role   Role
  active Boolean @default(true)

  /// Supervision is data, not code: repointing this reroutes both read access
  /// to progress notes and the co-signature queue, with no deploy.
  supervisorId String?
  supervisor   User?   @relation("supervision", fields: [supervisorId], references: [id])
  supervisees  User[]  @relation("supervision")

  clients       Client[]
  appointments  Appointment[]
  series        AppointmentSeries[]
  availability  Availability[]
  overrides     AvailabilityOverride[]
  progressNotes ProgressNote[]         @relation("noteAuthor")
  coSigned      ProgressNote[]         @relation("noteCoSigner")
  processNotes  ProcessNote[]
  amendments    NoteAmendment[]
  alerts        Alert[]

  createdAt                 DateTime            @default(now())
  rescheduleRequestsHandled RescheduleRequest[]
  inboundRepliesHandled     InboundReply[]
  inquiriesTaken            Inquiry[]           @relation("inquiryTakenBy")
  inquiriesRequested        Inquiry[]           @relation("inquiryRequested")
  inquiriesAssigned         Inquiry[]           @relation("inquiryAssigned")

  departures          Departure[]           @relation("departingUser")
  departuresPlanned   Departure[]           @relation("departurePlanner")
  superviseesReceived Departure[]           @relation("departureReceivingSupervisor")
  caseloadReceived    DepartureAssignment[] @relation("departureReceiver")
  dispositionsDecided DepartureAssignment[] @relation("departureDecider")

  leaves           Leave[]         @relation("leaveUser")
  leavesPlanned    Leave[]         @relation("leavePlanner")
  leavesCovering   Leave[]         @relation("leaveCoverer")
  coverageCovering LeaveCoverage[] @relation("leaveCoverageCoverer")
  coverageDecided  LeaveCoverage[] @relation("leaveCoverageDecider")

  /// P2: whether this clinician is taking somebody new right now — the
  /// declared half of the capacity signal, and theirs alone to set. It is a
  /// signal and never a gate: front desk still assigns to a closed clinician
  /// when the caller asked for them by name, and sees a warning saying so.
  /// The measured half — caseload, and the queue already assigned — is derived
  /// from rows that already exist and has no column, because a number a person
  /// has to maintain is a number that goes stale.
  acceptingNewClients Boolean @default(true)
}

enum ReminderPreference {
  email
  sms
  none
}

/// Languages the practice can write a client in. Adding one is not a
/// translation job: a language without its own deny-list would send bodies
/// past the only control that stops a lock-screen disclosure.
enum Language {
  en
  es
}

enum ClientStatus {
  active
  inactive
}

model Client {
  id   String @id @default(cuid())
  /// Obviously-fake display code for seeded data, e.g. "TC-001".
  code String @unique

  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  email       String?
  phone       String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  treatingClinicianId String
  treatingClinician   User   @relation(fields: [treatingClinicianId], references: [id])

  /// Sliding-scale override in integer cents. Null falls back to the practice
  /// standard fee.
  feeCents Int?

  reminderPreference ReminderPreference @default(email)
  /// Which cadence stages this client has asked for. Empty is the normal
  /// state and means "whatever the practice cadence says", streak cap and
  /// all. A non-empty list is the client's own answer to the volume question,
  /// so the cap does not also apply — two reductions stacked would silence
  /// somebody who only asked for fewer.
  reminderStages     ReminderStage[]
  /// The language this client is written to in. The deny-list that keeps a
  /// body discreet is per-language, so a language exists here only once its
  /// terms do — see `DENY_LISTS`.
  language           Language           @default(en)
  status             ClientStatus       @default(active)

  /// How they found the practice — the business-tier half of a fact the intake
  /// form also asks (P0-9, D-04). The form's answer is a `FormSubmission`
  /// guarded at `treatingOrSupervising`; this one is demographics, which is
  /// what lets the practice manager run the referral report without reading a
  /// clinical answer. The two are never reconciled. Null is honest: it means
  /// nobody recorded it, not "other".
  referralSource ReferralSource?
  referralNote   String?

  appointments  Appointment[]
  series        AppointmentSeries[]
  progressNotes ProgressNote[]
  processNotes  ProcessNote[]
  formRequests  FormRequest[]
  submissions   FormSubmission[]
  alerts        Alert[]
  outbox        OutboxMessage[]
  waitlist      WaitlistEntry[]

  createdAt            DateTime              @default(now())
  portalLinks          PortalLink[]
  rescheduleRequests   RescheduleRequest[]
  inboundReplies       InboundReply[]
  /// The call this client started as, where there was one.
  inquiry              Inquiry?
  /// The decisions made about this client when a clinician left.
  departureAssignments DepartureAssignment[]
  leaveCoverage        LeaveCoverage[]

  @@index([treatingClinicianId])
}

model PracticeSettings {
  id                    Int    @id @default(1)
  name                  String @default("Stillwater Counseling")
  /// The name that appears in messages to clients. Deliberately not the legal
  /// name: "Stillwater Counseling" in an SMS preview on a lock screen tells a
  /// roommate what the appointment is for.
  messagingName         String @default("Stillwater")
  standardFeeCents      Int    @default(18000)
  lateCancelWindowHours Int    @default(24)
  lateCancelFeeCents    Int    @default(9000)
  /// How far ahead recurring series materialise instances.
  recurrenceHorizonDays Int    @default(90)
  /// P1-1: a client is "continuity at risk" after this long with nothing booked.
  continuityGapDays     Int    @default(21)

  /// A no-show is its own policy. Ships at the late-cancel figure so the field
  /// changes no behaviour on the day it lands; the practice raises it without a
  /// code change. Integer cents.
  noShowFeeCents           Int     @default(9000)
  /// Lead time for the day-of confirmation stage.
  dayOfLeadHours           Int     @default(3)
  /// Below this much notice there was no time to ask, and after this much of
  /// the session has passed, silence is an answer.
  graceMinutes             Int     @default(20)
  /// Gates only the automatic `no_show` transition and its fee. With it off,
  /// non-response is still recorded — the evidence is never optional.
  autoNoShowOnNoResponse   Boolean @default(true)
  /// The number a client is asked to ring when the practice cannot answer them
  /// where they wrote. Client-facing, so it is the practice's own line — the
  /// auto-reply that carries it is the one message allowed to name an outside
  /// service's number as well (P1-3).
  practicePhone            String  @default("(555) 010-0199")
  /// P1-2. After this many consecutive confirmations a client drops to the
  /// day-before stage alone, until they miss one. Zero turns the cap off.
  /// A weekly client otherwise receives three messages a week, indefinitely,
  /// and the failure mode is not cost — it is the reminder stopping being read.
  confirmationStreakCap    Int     @default(4)
  /// How long a discarded inquiry survives before the purge destroys it. The
  /// window is application policy and lives here; the invariant that only a
  /// discarded row may be destroyed at all is a database trigger. 90 days is a
  /// legal question with a placeholder answer. The window for every discard
  /// reason but the two below, which want their own clock.
  inquiryRetentionDays     Int     @default(90)
  /// `spam` never had a real caller behind it; there is nothing worth even 90
  /// days of holding.
  spamRetentionDays        Int     @default(7)
  /// `referred_out` is the one discard that becomes a business record — proof
  /// the practice acted on a call it could not take — so it outlives the
  /// general window by an order of magnitude.
  referredOutRetentionDays Int     @default(365)

  /// P0-10: how long a departed clinician's process notes survive being
  /// unreachable before the sweep destroys them.
  ///
  /// Seven years, which is long, and the PRD is explicit that it is not
  /// defending the number: what happens to a departing clinician's private
  /// process notes is a professional and jurisdictional question, not an
  /// engineering one. In several jurisdictions those notes are the clinician's
  /// own defence in a complaint made two years later, so the failure mode of a
  /// short window is far worse than that of a long one. The settings page says
  /// this, in the same register as `inquiryRetentionDays`.
  processNoteAfterDepartureDays Int @default(2555)

  /// P2: whether the public enquiry form accepts anything at all.
  ///
  /// Off by default, because the route existing is not consent to run an
  /// unauthenticated write endpoint — a deployment turns it on deliberately.
  /// It is also the kill switch: a practice being flooded closes the door from
  /// the settings row, with no deploy and no code change.
  publicInquiryEnabled Boolean @default(false)
  /// How many enquiries one submitter may send in an hour before the form
  /// stops accepting. Low on purpose: a person enquiring twice has changed
  /// their mind, and a person enquiring four times is not a person.
  publicInquiryPerHour Int     @default(3)
}

model Room {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  appointments Appointment[]
  series       AppointmentSeries[]
}

// ───────────────────────────── availability ─────────────────────────────

model Availability {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  /// 0 = Sunday.
  weekday     Int
  /// Minutes from local midnight, practice timezone.
  startMinute Int
  endMinute   Int

  @@unique([userId, weekday, startMinute])
}

enum OverrideKind {
  unavailable
  available
}

model AvailabilityOverride {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  /// Inclusive date range, so a week of vacation is one row.
  fromDate    DateTime     @db.Date
  toDate      DateTime     @db.Date
  kind        OverrideKind @default(unavailable)
  startMinute Int?
  endMinute   Int?
  /// Operational, never clinical. Shown to front desk.
  reason      String?

  /// The leave that owns this row, if one does (leave P0-7). The calendar's
  /// source and never coverage's: a bare override grants nobody anything.
  leave Leave?

  @@index([userId, fromDate])
}

// ────────────────────────────── scheduling ──────────────────────────────

enum AppointmentType {
  intake // 75 min
  standard // 50 min
  extended // 80 min
}

enum Modality {
  in_person
  telehealth
}

enum Frequency {
  weekly
  biweekly
}

model AppointmentSeries {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  clinicianId String
  clinician   User    @relation(fields: [clinicianId], references: [id])
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id])

  type     AppointmentType @default(standard)
  modality Modality        @default(in_person)

  frequency   Frequency @default(weekly)
  weekday     Int
  startMinute Int

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  active    Boolean   @default(true)

  appointments Appointment[]
  createdAt    DateTime      @default(now())

  @@index([clientId])
  @@index([clinicianId])
}

enum AppointmentStatus {
  scheduled
  confirmed
  arrived
  in_session
  completed
  no_show
  cancelled
  late_cancelled
}

/// A communication fact, and never an attendance fact. `status` says whether
/// the client was in the room; this says whether they answered the question.
/// Collapsing the two makes charging somebody who turned up reachable by
/// writing no code at all.
enum AppointmentConfirmation {
  not_required
  pending
  confirmed
  declined
  no_response
}

/// A fixed list, not free text: a waiver reason is a category the practice
/// reports on, and free text on a money reversal becomes a place to write
/// something clinical.
enum FeeWaiveReason {
  practice_error
  client_disputed
  emergency
  goodwill
}

model Appointment {
  id             String             @id @default(cuid())
  seriesId       String?
  series         AppointmentSeries? @relation(fields: [seriesId], references: [id])
  /// P2: a group session is N appointments sharing this key, one per attendee,
  /// so notes, fees, attendance and audit stay per-client. The exclusion
  /// constraints treat co-attendees as one booking of the clinician and room.
  groupSessionId String?
  groupSession   GroupSession?      @relation(fields: [groupSessionId], references: [id])
  /// A rescheduled instance detaches from its pattern and stops being
  /// regenerated. Same regression that bit Groundwork.
  detached       Boolean            @default(false)

  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  clinicianId String
  clinician   User    @relation(fields: [clinicianId], references: [id])
  /// Null for telehealth. The room requirement is conditional on modality —
  /// enforced by a CHECK constraint in the migration, not just here.
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id])

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  type     AppointmentType   @default(standard)
  modality Modality          @default(in_person)
  status   AppointmentStatus @default(scheduled)

  /// Telehealth join URL. Not a video integration; a text field.
  joinLink String?

  cancelledAt    DateTime?
  cancelledById  String?
  /// Operational reason only ("client rescheduled"). Never clinical.
  cancelReason   String?
  /// Set when a cancellation lands inside the late-cancel window, or on
  /// no-show. Chargeable flag only — no payment processing here.
  chargeFeeCents Int?

  /// Written by the cadence job and the client's own door, by nothing else.
  confirmation AppointmentConfirmation @default(not_required)

  /// Why the client said no, when there was a door to ask through. The portal's
  /// four existing codes rather than a parallel vocabulary — a decline and a
  /// reschedule request are the same four sentences, and a second enum would be
  /// a second list to keep in sync for no gain.
  ///
  /// Null is the common, honest case and is not a gap: a keyword decline (P1-3)
  /// arrives as one word and can never carry a reason, and the portal asks
  /// without requiring an answer. Null means "did not say", never "unknown".
  declineReason RescheduleReason?

  /// A waiver zeroes the flag and records who decided. The original amount
  /// stays recoverable from the audit trail rather than being overwritten out
  /// of existence. Practice manager only.
  feeWaivedById  String?
  feeWaivedAt    DateTime?
  feeWaiveReason FeeWaiveReason?

  /// Idempotency key for recurrence materialisation: series + occurrence date.
  occurrenceKey String? @unique

  progressNote       ProgressNote?
  processNotes       ProcessNote[]
  rescheduleRequests RescheduleRequest[]
  reminders          AppointmentReminder[]
  inboundReplies     InboundReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicianId, startAt])
  @@index([clientId, startAt])
  @@index([roomId, startAt])
  @@index([status, startAt])
  @@index([groupSessionId])
  @@index([confirmation, startAt])
}

enum ReminderStage {
  d5
  d1
  d0
}

/// One row per appointment per stage, under a unique index — the same
/// idempotency-key discipline as `Appointment.occurrenceKey`. A second horizon
/// run over the same window sees the row and skips, so a cadence cannot double
/// -send by being run twice.
model AppointmentReminder {
  id              String         @id @default(cuid())
  appointmentId   String
  appointment     Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  stage           ReminderStage
  dueAt           DateTime       @db.Timestamptz(3)
  sentAt          DateTime?
  /// The proof the practice asked — and, since delivery receipts, the proof it
  /// arrived. A real relation rather than a loose id, because a dangling id is
  /// exactly the failure that would silently un-prove it; `Restrict` means the
  /// evidence cannot be deleted out from under the fee.
  outboxMessageId String?        @unique
  outboxMessage   OutboxMessage? @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([appointmentId, stage])
  @@index([dueAt, sentAt])
}

/// The shared half of a group session, and deliberately only that.
///
/// Time, clinician and room are NOT stored here: every attendee's appointment
/// already carries them, and a second copy is a second thing to keep in sync.
/// What is here is what has no other home — the operational label.
model GroupSession {
  id    String  @id @default(cuid())
  /// Operational label ("Tuesday skills group"). Never clinical content: this
  /// reaches the front-desk calendar.
  topic String?

  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

// ──────────────────────────── clinical notes ────────────────────────────

enum ProgressNoteStatus {
  draft
  signed
  cosigned
  /// P0-4b: a draft whose author left before signing it. Terminal, reachable
  /// only from `draft`, and it grants nobody anything — `sign` stays `author`,
  /// and the author is gone. The content is retained at exactly the tier a
  /// draft was already readable at; the row simply stops pretending it is on
  /// its way somewhere. Enforced by `progress_note_content_frozen`.
  abandoned
}

/// The official clinical record. Author + supervisor-of-author + break-glass.
model ProgressNote {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])

  authorId String
  author   User   @relation("noteAuthor", fields: [authorId], references: [id])

  content String
  status  ProgressNoteStatus @default(draft)

  signedAt     DateTime?
  /// `Restrict`, not the implicit `SetNull` this was (P0-8). A co-signature is
  /// an assertion made by a named person on a date, and a foreign key that can
  /// quietly null it describes a record that can lose its second signer. This
  /// changes nothing today — every other reference to `User` already refuses
  /// the delete — and that is the point: the schema now says what the system
  /// means instead of relying on the neighbours to mean it.
  coSignedById String?
  coSignedBy   User?     @relation("noteCoSigner", fields: [coSignedById], references: [id], onDelete: Restrict)
  coSignedAt   DateTime?

  /// Why this note stopped being a draft without being signed (P0-4b). Set in
  /// the departure transaction, and the reason `abandoned` is a fact with a
  /// cause attached rather than a status somebody set by hand. A CHECK keeps
  /// the two from disagreeing in either direction.
  abandonedByDepartureId String?
  abandonedByDeparture   Departure? @relation(fields: [abandonedByDepartureId], references: [id], onDelete: Restrict)

  amendments NoteAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([authorId, status])
}

/// The therapist's private working notes. Author-only at every layer — query,
/// API, export, search, report. There is no supervisor path and no break-glass
/// path to this table's content.
model ProcessNote {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content  String
  /// Signed-off equivalent: process notes have no signature workflow, but they
  /// become immutable once the author closes them, and amend appends.
  closedAt DateTime?

  /// P0-10: when this note's only reader stopped existing. Nothing about the
  /// permission changes — `read: 'author'` was already true and is already
  /// unsatisfiable — this column records *when* that became true, which is
  /// what the destruction window counts from and what
  /// `process_note_delete_only_after_departure` checks before allowing a row
  /// to be destroyed at all.
  unreachableSince DateTime?

  amendments NoteAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, clientId])
  @@index([unreachableSince])
}

enum NoteKind {
  progress
  process
}

/// Signed notes are immutable; corrections append an amendment.
model NoteAmendment {
  id   String   @id @default(cuid())
  kind NoteKind

  progressNoteId String?
  progressNote   ProgressNote? @relation(fields: [progressNoteId], references: [id])
  /// `Cascade`, not the `SetNull` an optional relation takes by default. An
  /// amendment carries its own `content`, so a nulled `processNoteId` is the
  /// text of a private note surviving the note it belonged to — the one place
  /// `SetNull` would have quietly defeated the P0-10 destruction. Deleting an
  /// amendment is still refused everywhere else: see
  /// `note_amendment_append_only`, which permits it only as the child of a
  /// process note that is already unreachable.
  processNoteId  String?
  processNote    ProcessNote?  @relation(fields: [processNoteId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
}

// ──────────────────────────────── forms ────────────────────────────────

enum FormKind {
  intake
  consent
  screener
}

model FormTemplate {
  id        String   @id @default(cuid())
  key       String
  name      String
  kind      FormKind
  version   Int      @default(1)
  published Boolean  @default(false)

  /// Field definitions, including conditional-display rules.
  schema  Json
  /// Answer→value maps, total thresholds, and critical items. Versions with the
  /// template, so a v1 submission always scores by v1 rules.
  scoring Json?

  requests    FormRequest[]
  submissions FormSubmission[]

  createdAt DateTime @default(now())

  @@unique([key, version])
}

enum FormRequestStatus {
  sent
  started
  submitted
  expired
}

model FormRequest {
  id         String       @id @default(cuid())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id])
  /// Pinned to the exact template version the client is answering.
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id])

  /// Opaque, high-entropy, single-purpose. Carries no PHI.
  token     String            @unique
  status    FormRequestStatus @default(sent)
  expiresAt DateTime

  /// Answers saved as the client works. Tokenized links are resumable: a
  /// screener asking hard questions is not something to finish in one sitting.
  draftAnswers Json?

  sentAt      DateTime  @default(now())
  startedAt   DateTime?
  submittedAt DateTime?

  submission FormSubmission?

  @@index([clientId, status])
}

model FormSubmission {
  id         String       @id @default(cuid())
  requestId  String       @unique
  request    FormRequest  @relation(fields: [requestId], references: [id])
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id])
  /// The version answered. Rendering always uses this, never the latest.
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id])

  answers Json

  totalScore    Int?
  /// True when the total crossed a threshold or a critical item was flagged.
  needsReview   Boolean  @default(false)
  /// Rule identifiers only, e.g. ["threshold:moderate", "critical:item_9"].
  /// Never answer content — this string reaches alert and review surfaces.
  reviewReasons String[] @default([])

  /// Consent signature stub.
  signatureName String?
  signedAt      DateTime?

  alerts    Alert[]
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─────────────────────────── alerts and outbox ───────────────────────────

enum AlertKind {
  screener_threshold
  screener_critical_item
  /// A client wrote back in words the classifier could not place. The alert
  /// carries the code and nothing else, because the words were never stored.
  inbound_unparsed
}

/// Routes to the treating clinician only. Never a shared surface, never front
/// desk. Carries reason codes, never answers or scores.
model Alert {
  id          String @id @default(cuid())
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id])
  clientId    String
  client      Client @relation(fields: [clientId], references: [id])

  submissionId String?
  submission   FormSubmission? @relation(fields: [submissionId], references: [id])

  kind    AlertKind
  reasons String[]  @default([])

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  /// Set when coverage chose the recipient (leave P0-5), so the boundary sweep
  /// moves back exactly the unread alerts a leave moved, and nothing else.
  coveringLeaveId String?
  coveringLeave   Leave?  @relation(fields: [coveringLeaveId], references: [id], onDelete: Restrict)

  @@index([recipientId, acknowledgedAt])
  /// The boundary sweep reads unread alerts a leave moved.
  @@index([coveringLeaveId])
}

enum OutboxChannel {
  email
  sms
}

/// How far a message actually got. The fee rule reads this and nothing else:
/// `queued` is an intention, `delivered` is a receipt, and only the second one
/// is evidence the practice asked.
enum DeliveryState {
  queued
  sent
  delivered
  failed
}

/// Nothing is actually sent. Bodies are lint-tested against a deny-list of
/// clinical terms — a reminder says "Appointment reminder", never why.
model OutboxMessage {
  id       String  @id @default(cuid())
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  /// Set for clinician-directed alerts.
  userId   String?

  channel     OutboxChannel
  templateKey String
  subject     String?
  body        String

  scheduledFor DateTime
  sentAt       DateTime?

  /// queued → sent → delivered | failed. Never moves out of a terminal state.
  deliveryState DeliveryState @default(queued)
  deliveredAt   DateTime?
  /// A carrier's reason CODE for a failure. Never a body, never a client's
  /// words — the same rule the inbound classifier lives by.
  failureCode   String?

  createdAt DateTime @default(now())

  reminder AppointmentReminder?

  @@index([scheduledFor, sentAt])
  @@index([deliveryState])
}

// ──────────────────────────────── waitlist ────────────────────────────────

model WaitlistEntry {
  id String @id @default(cuid())

  /// Exactly one of these, enforced by a CHECK constraint rather than by
  /// whoever writes the next insert. This is the one place the inquiry stage
  /// earns a nullable FK, and it earns it because "wants a slot we do not
  /// have" is the reason most inquiries stay inquiries (P0-7).
  clientId  String?
  /// `Restrict`, spelled out: an optional relation defaults to `SetNull`, and
  /// silently nulling this column would leave a row that satisfies neither
  /// half of the check below. Nothing deletes a client anyway.
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// The schema's only cascade, next to the schema's only DELETE path. A
  /// waitlist entry for a person who no longer exists is not a thing, and
  /// making the database say so is what keeps the purge from needing to know
  /// about this table at all.
  inquiryId String?
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  /// Preferred weekdays (0 = Sunday) and window, both optional.
  weekdays       Int[]   @default([])
  earliestMinute Int?
  latestMinute   Int?
  note           String?
  active         Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([inquiryId])
}

// ───────────────────────────── audit trail ─────────────────────────────

/// Append-only. A database rule blocks UPDATE and DELETE — see the migration.
/// Ids only: no names, no note content, no answers, no scores.
model AuditEvent {
  id String   @id @default(cuid())
  at DateTime @default(now())

  actorId   String
  actorRole Role

  action     String
  resource   String
  resourceId String?
  /// Denormalised so "who touched client X" is one indexed query.
  clientId   String?

  allowed    Boolean
  /// Which permission rule decided it.
  rule       String
  breakGlass Boolean @default(false)
  /// Break-glass justification. Operational text typed by an admin.
  reason     String?

  @@index([clientId, at])
  @@index([actorId, at])
  @@index([breakGlass, at])
  @@index([at])
}

// ──────────────────────────── the client portal ────────────────────────────

/// A client's own door. Opaque, expiring, and carrying no PHI — the same shape
/// as a form link, for the same reason: a link that leaks discloses that this
/// person has appointments somewhere, and stops there.
model PortalLink {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  token     String   @unique
  expiresAt DateTime

  createdAt    DateTime  @default(now())
  lastOpenedAt DateTime?

  @@index([clientId])
}

/// Why a client wants a different time, as a code rather than a message.
///
/// A free-text box here would be a channel by which a client can write clinical
/// content to the one desk that must never see it. Front desk phones them back;
/// that conversation is not this system's to hold.
enum RescheduleReason {
  cannot_make_it
  need_a_different_time
  prefer_earlier
  prefer_later
}

enum RescheduleRequestStatus {
  open
  handled
  declined
}

/// A request, never a booking. The client asks; front desk decides and rebooks
/// by hand — the same rule as the waitlist, and for the same reason.
model RescheduleRequest {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])

  reason RescheduleReason
  status RescheduleRequestStatus @default(open)

  createdAt   DateTime  @default(now())
  handledById String?
  handledBy   User?     @relation(fields: [handledById], references: [id])
  handledAt   DateTime?

  @@index([status, createdAt])
  @@index([clientId])
}

// ──────────────────────────── inbound replies ────────────────────────────

/// What a client's reply meant. Never what it said.
enum InboundClassification {
  confirm
  decline
  unparsed
}

/// A client wrote back, and this is the whole of what the practice kept.
///
/// There is no body column, and that is the feature (D-04). A client can reply
/// with anything to a number front desk monitors, including the most acute
/// thing this practice ever receives — so the words are classified in memory
/// and dropped, and what lands in a row is one of three codes. An `unparsed`
/// raises an alert to the treating clinician and tells front desk "call them",
/// which is the most either of them can safely be given.
///
/// `handledAt` is the same shape as `RescheduleRequest`, for the same reason: a
/// list front desk cannot clear is a list front desk stops reading.
model InboundReply {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  /// The appointment the reply was taken to be about, where there was one.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  classification InboundClassification

  receivedAt  DateTime  @default(now())
  handledById String?
  handledBy   User?     @relation(fields: [handledById], references: [id])
  handledAt   DateTime?

  @@index([classification, handledAt])
  @@index([clientId])
}

// ──────────────────────────────── intake ────────────────────────────────

/// How somebody found the practice, at the front-desk tier.
///
/// The values are exactly the `referral` options in `intakeForm`, and a test
/// asserts it. The same fact exists twice on purpose (D-04): the form answer is
/// a `FormSubmission` a practice manager may not read, and this one is a
/// category the referral report is built on.
enum ReferralSource {
  gp
  friend
  search
  other
}

/// Why an inquiry ended without a client, as a code (P0-3).
///
/// Free text here would be the one field on this table that reaches the audit
/// log, read by the one role that may not open a record — the same argument
/// `FeeWaiveReason` makes about a money reversal.
enum InquiryDiscardReason {
  no_answer
  not_a_fit
  referred_out
  no_capacity
  chose_elsewhere
  duplicate
  spam
}

/// Who sent them, or who we sent them to (P2).
///
/// The entity behind two codes that were previously only codes: a
/// `referralSource` of `gp`, and a `referred_out` discard. "GP" as an enum
/// value answers *how many* and can never answer *which surgery has stopped
/// sending anybody* — and that second question is the one a practice acts on.
///
/// Deliberately one table for both directions rather than `Referrer` and
/// `ReferralDestination`. It is the same six surgeries either way: the one you
/// send an eating-disorder case to is the one that sends you their anxiety
/// referrals next month, and two tables would hold that relationship twice and
/// let the halves drift.
///
/// Holds no client and no clinical content — it is a business contact list,
/// which is why it survives the purge that destroys the enquiries pointing at
/// it and why `onDelete: Restrict` guards both directions.
model Referrer {
  id String @id @default(cuid())

  /// The surgery, agency or practice. Required: an unnamed doctor at a named
  /// surgery is still somebody front desk can ring, and a named doctor at
  /// nowhere is not.
  practice String
  /// The person there, where there is one.
  name     String?

  phone String?
  email String?

  /// Retired, never deleted — enquiries point here and the report reads them.
  /// A surgery that has stopped taking referrals is a fact about now, not a
  /// reason to rewrite what happened last March.
  active Boolean @default(true)

  createdAt DateTime @default(now())

  referredIn            Inquiry[]             @relation("inquiryReferrer")
  referredOut           Inquiry[]             @relation("inquiryReferredOut")
  /// The other direction, from the other end of a career: a client sent here
  /// when their clinician left.
  departuresReferredOut DepartureAssignment[] @relation("departureReferredOut")

  @@unique([practice, name])
  @@index([active])
}

/// Both endings are terminal. See `src/clients/inquiry.ts`.
enum InquiryStatus {
  open
  converted
  discarded
}

/// Somebody rang. That is all this is, and it is the only table in the schema
/// a row can ever leave (P0-1, D-01).
///
/// Deliberately not a `Client` with nulls: `Client` is the foreign-key root of
/// every clinical table here, and pointing a `DELETE` at it would put the whole
/// record within reach of a retention sweep. A separate model keeps deletion
/// aimed at a table that by construction holds no clinical content, and lets
/// `inquiry_delete_only_discarded` say so in the database.
///
/// **No `dateOfBirth`, no `code`, no `treatingClinicianId`** — those three are
/// what conversion is for. **No relation to `ProgressNote`, `ProcessNote`,
/// `FormRequest`, `FormSubmission`, `Alert`, `Appointment`, `PortalLink` or
/// `OutboxMessage`**, and nothing is ever sent to an inquiry (D-05). Both are
/// enforced by there being no column, and asserted by `inquiry.test.ts`.
model Inquiry {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String?
  email     String?

  /// Who they asked for, where they asked for anybody. Not a treating
  /// relationship: nobody is treating a caller.
  requestedClinicianId String?
  requestedClinician   User?   @relation("inquiryRequested", fields: [requestedClinicianId], references: [id])

  /// P2: whose queue this call is in. Distinct from `requestedClinician` on
  /// purpose — one is what the caller said, the other is what the practice
  /// decided, and collapsing them would lose the case where front desk sends a
  /// caller somewhere other than the name they asked for. Null is the default
  /// and is the unassigned queue front desk works from.
  ///
  /// `Restrict`, for the same reason `takenBy` is: null here means "nobody has
  /// been given this call", and a cascade that quietly produced one when a
  /// clinician left would turn a handover into an unassigned row nobody notices.
  assignedClinicianId String?
  assignedClinician   User?   @relation("inquiryAssigned", fields: [assignedClinicianId], references: [id], onDelete: Restrict)

  referralSource ReferralSource
  referralNote   String?

  /// Which practice, which doctor (P2). Only ever set alongside
  /// `referralSource = gp`, and a database CHECK is what says so — the code
  /// and the entity are one fact, and a row where they disagree is not
  /// something to validate on the way in, it is something to make impossible.
  ///
  /// `Restrict`, like every other optional relation on this table: null here
  /// means "nobody recorded which surgery", and a cascade that quietly
  /// produced one when a contact was tidied up would turn a known referrer
  /// into an unknown one with no trace.
  referrerId String?
  referrer   Referrer? @relation("inquiryReferrer", fields: [referrerId], references: [id], onDelete: Restrict)

  /// Where we sent them instead. The other half of the same entity, and only
  /// ever set with `discardReason = referred_out` — also a CHECK.
  ///
  /// This is why `referred_out` has its own 365-day retention window: it is
  /// the record of the practice having *acted*, and without a destination that
  /// record said only that somebody was turned away.
  referredOutToId String?
  referredOutTo   Referrer? @relation("inquiryReferredOut", fields: [referredOutToId], references: [id], onDelete: Restrict)
  /// Operational free text at the front-desk tier — the same tier as
  /// `WaitlistEntry.note`, and the honest weak point of this design. The purge
  /// is what bounds how long whatever ends up here survives.
  note            String?

  status        InquiryStatus         @default(open)
  discardReason InquiryDiscardReason?
  /// What the retention window counts from.
  discardedAt   DateTime?

  /// The staff member who took the call, or null when nobody did — a public
  /// form submission arrived on its own. That null is the only marker the
  /// worklist needs: an enquiry nobody has picked up yet.
  takenById String?
  /// `Restrict`, not the default `SetNull` an optional relation would take:
  /// null here means "nobody took this call", and a cascade that quietly
  /// produced one when a staff account was deleted would rewrite history into
  /// enquiries that arrived on their own.
  takenBy   User?   @relation("inquiryTakenBy", fields: [takenById], references: [id], onDelete: Restrict)

  /// Set at conversion, and deliberately absent until then (P0-8). The row is
  /// retained afterwards — it is what makes "how long from call to first
  /// session" answerable — and the trigger already refuses to destroy it.
  clientId String? @unique
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  waitlist WaitlistEntry[]

  createdAt DateTime @default(now())

  @@index([status, discardedAt])
  @@index([requestedClinicianId])
  @@index([status, assignedClinicianId])
  @@index([referrerId])
}

/// One submitter's recent use of the public enquiry form (P2).
///
/// The only reason this table exists is that the public form is an
/// unauthenticated write, and an unauthenticated write with no ceiling is the
/// liability the PRD named. It holds no enquiry, no name and no address — see
/// `submitterKey`, which is why the primary key is a keyed hash rather than
/// the IP it stands for. Rows outlive their window only until the next purge
/// sweep clears them.
model InquiryThrottle {
  /// HMAC of the submitter's address. Never the address.
  id              String   @id
  count           Int      @default(0)
  windowStartedAt DateTime

  @@index([windowStartedAt])
}

// ─────────────────────────────── departure ───────────────────────────────

/// Both endings are terminal. See `src/staff/departure.ts`, which owns the
/// transitions; this enum only says what the column may hold.
enum DepartureStatus {
  planned
  executed
  cancelled
}

/// What happens to one client on a leaving caseload (P0-1).
///
/// Codes, in the idiom of `FeeWaiveReason` and `InquiryDiscardReason`, and for
/// the same reason: this value reaches the audit log as `departure:<code>`, and
/// the audit log is read by the one role that may not open a record.
enum DepartureDisposition {
  transfer
  discharge
  referred_out
}

/// A departure is a plan before it is an event (P0-1).
///
/// `noticeAt` and `lastDayOn` are two different facts and both matter: the gap
/// between them is the thirty days the practice has to decide fifteen
/// dispositions and clear the hour clashes. Notice closes the clinician's
/// books; execution closes the account (P0-9).
///
/// A person may leave twice in a career but not twice at once, which is a
/// partial unique index on `planned` rather than a unique on `userId` — see
/// `departure_one_open_per_user` in the migration. Prisma has no syntax for it.
model Departure {
  id String @id @default(cuid())

  /// The person leaving. `Restrict`, like every other reference to `User`: the
  /// row is a permanent fact about the audit trail and six other tables
  /// already say so.
  userId String
  user   User   @relation("departingUser", fields: [userId], references: [id], onDelete: Restrict)

  noticeAt  DateTime
  /// A date, not an instant. The last day is a day everywhere it is used —
  /// which appointments move, how many days a draft has left — and a timestamp
  /// would make that a timezone question it has no business being.
  lastDayOn DateTime @db.Date

  status DepartureStatus @default(planned)

  /// Who recorded the notice. Admin or supervisor; `depart` is admin alone.
  plannedById String
  plannedBy   User   @relation("departurePlanner", fields: [plannedById], references: [id], onDelete: Restrict)

  /// Set when the caseload actually moved. A `departure_execution_is_complete`
  /// CHECK keeps this and `status` from disagreeing.
  executedAt DateTime?

  /// P0-8: who the departing supervisor's supervisees answer to afterwards.
  ///
  /// On `Departure` rather than per-supervisee, because a supervision tree is
  /// not a caseload: the argument that split `DepartureAssignment` off — some
  /// clients follow the fit, some the hour, some end — has no counterpart here.
  /// Associates move together or the practice has quietly restructured itself
  /// inside a departure, which is a thing to do deliberately with `user.update`
  /// and not a side effect of somebody's last day.
  ///
  /// Null is the ordinary case: most people leaving supervise nobody. A
  /// departing supervisor who still has supervisees and no receiver here is a
  /// blocking item on the plan, refused at execution rather than in the schema
  /// — the column cannot see the supervisee rows that make it required.
  receivingSupervisorId String?
  receivingSupervisor   User?   @relation("departureReceivingSupervisor", fields: [receivingSupervisorId], references: [id], onDelete: Restrict)

  /// What `acceptingNewClients` said the moment before notice closed it
  /// (P0-9), so that `cancelled` can put it back rather than assume `true`.
  ///
  /// Without this column the reversal is a guess, and the guess is the exact
  /// widening D-10 refused: a clinician who had already closed their own books
  /// would come back open, and the practice manager would have set a capacity
  /// signal they do not hold `capacity.update` to set. Withdrawn notice
  /// restores the fact; it does not make a new one.
  acceptingNewClientsAtNotice Boolean @default(true)

  assignments DepartureAssignment[]
  /// The drafts this departure closed (P0-4b). Not a transfer of authorship —
  /// the relation names *why* a note stopped being on its way somewhere.
  abandoned   ProgressNote[]

  createdAt DateTime @default(now())

  @@index([status, lastDayOn])
  @@index([userId])
}

/// One client, one decision (P0-1, goal 2). No default and no silent remainder:
/// the departure will not execute while a client on the caseload has no row.
///
/// Deliberately not a single `receivingClinicianId` on `Departure`. Real
/// caseloads split — some clients follow the clinical fit, some follow the
/// hour, some end — and one column would have made the common case one field
/// and the real case impossible.
model DepartureAssignment {
  id String @id @default(cuid())

  departureId String
  departure   Departure @relation(fields: [departureId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  disposition DepartureDisposition

  /// Required for `transfer` and forbidden otherwise — a CHECK says so, in the
  /// register `inquiry_referrer_only_for_gp` set. A transfer with no receiver
  /// is an undecided row pretending to be decided, and that is the exact state
  /// this table exists to make impossible.
  receivingClinicianId String?
  receivingClinician   User?   @relation("departureReceiver", fields: [receivingClinicianId], references: [id], onDelete: Restrict)

  /// Where they went instead. The same `Referrer` a caller arrives from — the
  /// second direction the intake PRD's D-11 promised, and the reason that
  /// table is one table.
  referredOutToId String?
  referredOutTo   Referrer? @relation("departureReferredOut", fields: [referredOutToId], references: [id], onDelete: Restrict)

  decidedById String
  decidedBy   User     @relation("departureDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime @default(now())

  @@unique([departureId, clientId])
  @@index([clientId])
  @@index([receivingClinicianId])
}

// ─────────────────────────────── leave ───────────────────────────────

/// A dated absence, and who covers the caseload behind it (leave P0-1).
///
/// The treating clinician never changes (D-01). Coverage is a second reader
/// with an end date, and whether it is on today is derived from these dates by
/// `leavePhase` in `permissions.ts` (D-02, D-14). There is no status column:
/// the one stored transition is `cancelledAt`, and an early return is an edit
/// to `toDate`. No reason is stored, because front desk reads the row (D-12).
model Leave {
  id String @id @default(cuid())

  userId String
  user   User   @relation("leaveUser", fields: [userId], references: [id], onDelete: Restrict)

  /// Inclusive, practice-local, in the idiom of `AvailabilityOverride`.
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date

  /// Required (D-03): "every client is covered" holds from the first row. A
  /// `leave_coverer_is_not_away` CHECK refuses the person away.
  coveringClinicianId String
  coveringClinician   User   @relation("leaveCoverer", fields: [coveringClinicianId], references: [id], onDelete: Restrict)

  /// Admin, the only role holding `leave.create`.
  plannedById String
  plannedBy   User   @relation("leavePlanner", fields: [plannedById], references: [id], onDelete: Restrict)

  cancelledAt DateTime?

  /// The calendar row this leave owns (P0-7). Present exactly while the leave
  /// is not cancelled — `leave_calendar_row_while_live` — and `Restrict`, so
  /// the row cannot be deleted out from under a leave that still claims it.
  overrideId String?               @unique
  override   AvailabilityOverride? @relation(fields: [overrideId], references: [id], onDelete: Restrict)

  coverage LeaveCoverage[]
  alerts   Alert[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([coveringClinicianId])
}

/// One client covered by somebody other than the leave's coverer (P0-1).
///
/// An override, never a copy: there is no row for "same as the leave", so a
/// decision naming the leave's own coverer removes the row instead of writing
/// one. A trigger, `leave_coverage_coverer_is_not_away`, refuses the person
/// away — a CHECK cannot see the leave.
model LeaveCoverage {
  id String @id @default(cuid())

  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  coveringClinicianId String
  coveringClinician   User   @relation("leaveCoverageCoverer", fields: [coveringClinicianId], references: [id], onDelete: Restrict)

  decidedById String
  decidedBy   User     @relation("leaveCoverageDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime @default(now())

  @@unique([leaveId, clientId])
  @@index([coveringClinicianId])
}
